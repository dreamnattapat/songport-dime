{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "songport-dime",
  "compatibility_date": "2026-10-01",
  // The price proxy (ticker symbols only); see worker/index.ts.
  "main": "worker/index.ts",
  // Build the site before every deploy, so a plain `wrangler deploy` works too.
  "build": { "command": "npm run build" },
  // The built site in dist/. Requests are served from it, except /api/*,
  // which goes to the Worker.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/lynch", "/dream"]
  },
  // The anonymous usage totals (worker/usage.ts): three numbers, no personal data.
  "durable_objects": { "bindings": [{ "name": "USAGE", "class_name": "UsageCounter" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UsageCounter"] }]
}
